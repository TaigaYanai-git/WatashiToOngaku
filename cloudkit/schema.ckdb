// Our Music の CloudKit スキーマ（公開データベース）。開発環境はこの内容に合わせてある。
// 方針：どのフィールドにも検索用の索引（QUERYABLE / SEARCHABLE / SORTABLE）を付けない。
//   開発環境ではアプリが新しいフィールドを保存すると CloudKit が自動で索引を付けるので、
//   フィールドを増やすときは先にコンソールで（索引なしで）追加してから使うこと。
//   本番へは「Deploy Schema Changes…」で反映する。反映前に Indexes が空であることを確認する。
DEFINE SCHEMA

    // 利用者（CloudKit が自動で作る型）
    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );

    // フレンドコード（レコード名 = コード）→ ニックネーム・アイコン・公開鍵。
    // 鍵（secret）は申請・承認のときに相手の公開鍵で閉じて届けるので、ここには置かない（secret は古い版の名残で、常に空）。
    // 検索用の索引は付けない（付けると他人のコードを探し出せてしまう）。
    RECORD TYPE FriendCode (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        avatar          ASSET,
        avatarVersion   INT64,
        hidden          INT64,
        nickname        STRING,
        publicKey       BYTES,
        secret          STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    // 投稿（レコード名 = "s-<鍵>-<日付>"）。索引なし：鍵を知っている人だけがレコード名で読める
    RECORD TYPE Post (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        albumTitle      STRING,
        appleMusicURL   STRING,
        artist          STRING,
        artworkURL      STRING,
        clipStart       DOUBLE,
        dayKey          STRING,
        memo            STRING,
        postedAt        TIMESTAMP,
        previewURL      STRING,
        songID          STRING,
        title           STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    // フレンド申請の郵便受け（レコード名 = "r-<宛先コード>-<枠>"）。payload は送り主の鍵を宛先の公開鍵で閉じたもの。索引なし
    RECORD TYPE FriendRequest (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        fromCode        STRING,
        payload         BYTES,
        previousCode    STRING,
        sentAt          TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    // 通報。開発者が CloudKit コンソールで確認する。ほかの利用者には見せない
    RECORD TYPE Report (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        dayKey          STRING,
        memo            STRING,
        reason          STRING,
        reportedCode    STRING,
        reporterCode    STRING,
        title           STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_creator"
    );

    // フレンドの一覧（レコード名 = "fl-<鍵>"）。フレンドのフレンドを探すのに使う。索引なし
    RECORD TYPE FriendList (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        codes           LIST<STRING>,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    // コメント（レコード名 = "c-<投稿のレコード名>-<番号>"）。索引なし
    RECORD TYPE Comment (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        fromCode        STRING,
        postedAt        TIMESTAMP,
        replyTo         STRING,
        text            STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    // 投稿した人が自分の投稿から隠したコメント（レコード名 = "ch-<投稿のレコード名>"）。索引なし
    RECORD TYPE CommentHide (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        hidden          LIST<STRING>,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    // 通知の合図（"p-<目印>" = 投稿、"k|q|y-<送り主の鍵から作った目印>" = いいね・コメント・返信）。曲やメモは置かない。
    // tag は検索できるので全件を一覧できてしまう。ニックネームやフレンドコードは置かない（nickname は 1.0.5 (15) までの名残で、常に空）
    // 購読（CKQuerySubscription）に使うので、tag にだけ QUERYABLE の索引を付ける（例外）
    RECORD TYPE Ping (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        dayKey          STRING,
        nickname        STRING,
        tag             STRING QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    // コメントへの絵文字のリアクション（レコード名 = "rx-<投稿のレコード名>-<番号>"）。索引なし
    RECORD TYPE CommentReaction (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        commentID       STRING,
        emoji           STRING,
        fromCode        STRING,
        reactedAt       TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );
